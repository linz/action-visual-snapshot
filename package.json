{
  "name": "@linz/action-visual-snapshot",
  "version": "2.2.0",
  "private": true,
  "description": "GitHub Action to diff images",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build-template": "node src/template/build.ts",
    "format": "oxfmt . --write",
    "lint": "oxlint . --type-aware --fix && oxfmt . --write",
    "check": "oxlint . --type-aware && oxfmt . --check",
    "dist": "npm run build-template && npx esbuild --bundle --platform=node src/main.ts --outfile=dist/index.cjs",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linz/action-visual-snapshot.git"
  },
  "keywords": [
    "actions",
    "node",
    "visual-snapshot",
    "snapshot",
    "testing",
    "visual-regression"
  ],
  "author": "Sentry",
  "license": "MIT",
  "resolutions": {
    "node-forge": "^0.10.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.936.0",
    "@actions/artifact": "^2.2.1",
    "@actions/core": "^1.2.6",
    "@actions/exec": "^1.0.4",
    "@actions/github": "^4.0.0",
    "@actions/glob": "^0.1.0",
    "@actions/io": "^1.0.2",
    "@chunkd/fs": "^11.5.1",
    "@chunkd/fs-aws": "^11.6.1",
    "@types/async-retry": "^1.4.2",
    "@types/ejs": "^3.0.4",
    "@types/pixelmatch": "^5.2.2",
    "@types/pngjs": "^3.4.2",
    "async-retry": "^1.3.1",
    "ejs": "^3.1.5",
    "pixelmatch": "^5.2.1",
    "pngjs": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.17",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
